generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CooperativeRole {
  OWNER
  MANAGER
  AGENT
  PRODUCER
}

enum TraceabilityEventType {
  HARVEST_RECORDED
  QUALITY_CHECKED
  STORED
  DISPATCHED
  RECEIVED
}

enum SmsCategory {
  HARVEST
  WEATHER
  PAYMENT
  MARKET
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum MobileMoneyCheckoutStatus {
  CREATED
  PENDING
  PAID
  FAILED
}

model User {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  emailVerified   Boolean      @default(false)
  image           String?
  memberships     Membership[]
  sentInvitations Invitation[] @relation("InvitationSender")
  sessions        Session[]
  accounts        Account[]
  aiRecommendationRequests AiRecommendationRequest[]
  mobileMoneyCheckouts MobileMoneyCheckout[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model AiRecommendationRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model Cooperative {
  id        String     @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?
  countryCode String
  currency    String
  memberships Membership[]
  invitations Invitation[]
  producers   Producer[]
  farms       Farm[]
  payments    Payment[]
  marketListings MarketListing[]
  priceReports PriceReport[]
  transportRequests TransportRequest[]
  smsNotifications SmsNotification[]
  mobileMoneyCheckouts MobileMoneyCheckout[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Membership {
  id            String          @id @default(cuid())
  userId        String
  cooperativeId String
  role          CooperativeRole @default(PRODUCER)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cooperative   Cooperative    @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  @@unique([userId, cooperativeId])
  @@index([cooperativeId])
}

model Invitation {
  id            String          @id @default(cuid())
  email         String
  role          CooperativeRole
  tokenHash     String          @unique
  cooperativeId String
  invitedById   String
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime        @default(now())
  cooperative   Cooperative     @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  invitedBy     User            @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  @@index([cooperativeId, email])
}

model Producer {
  id            String       @id @default(cuid())
  firstName     String
  lastName      String
  phone         String
  village       String
  gender        String
  photo         String?
  identityCard  String?
  smsConsent    Boolean      @default(false)
  smsConsentAt  DateTime?
  cooperativeId String
  cooperative   Cooperative  @relation(fields: [cooperativeId], references: [id])
  farms         Farm[]
  harvests      Harvest[]
  payments      Payment[]
  smsNotifications SmsNotification[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Farm {
  id            String      @id @default(cuid())
  name          String
  gpsLocation   String
  area          Float
  latitude      Float?
  longitude     Float?
  producerId    String
  producer      Producer    @relation(fields: [producerId], references: [id])
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  crops         Crop[]
  createdAt     DateTime    @default(now())
}

model Crop {
  id              String    @id @default(cuid())
  name            String
  sowingDate      DateTime
  expectedHarvest DateTime
  status          String
  estimatedYield  Float
  farmId          String
  farm            Farm      @relation(fields: [farmId], references: [id])
  harvests        Harvest[]
  createdAt       DateTime  @default(now())
}

model Harvest {
  id         String   @id @default(cuid())
  batchCode  String   @unique @default(cuid())
  quantity   Float
  date       DateTime
  photos     String[]
  producerId String
  producer   Producer @relation(fields: [producerId], references: [id])
  cropId     String
  crop       Crop     @relation(fields: [cropId], references: [id])
  stocks     Stock[]
  traceabilityEvents TraceabilityEvent[]
  createdAt  DateTime @default(now())
}

model TraceabilityEvent {
  id         String                @id @default(cuid())
  type       TraceabilityEventType
  note       String
  location   String?
  eventDate  DateTime              @default(now())
  harvestId  String
  harvest    Harvest               @relation(fields: [harvestId], references: [id], onDelete: Cascade)
  createdAt  DateTime              @default(now())
  @@index([harvestId, eventDate])
}

model SmsNotification {
  id                 String      @id @default(cuid())
  category           SmsCategory
  toPhone            String
  message            String
  status             SmsStatus   @default(PENDING)
  dedupeKey          String?     @unique
  providerReference  String?
  error              String?
  cooperativeId      String
  cooperative        Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  producerId         String?
  producer           Producer?   @relation(fields: [producerId], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())
  sentAt             DateTime?
  @@index([cooperativeId, createdAt])
  @@index([status, createdAt])
}

model Stock {
  id        String   @id @default(cuid())
  type      String
  quantity  Float
  harvestId String
  harvest   Harvest  @relation(fields: [harvestId], references: [id])
  createdAt DateTime @default(now())
}

model Payment {
  id            String      @id @default(cuid())
  amount        Float
  method        String
  reference     String
  status        String      @default("RECORDED")
  producerId    String
  producer      Producer    @relation(fields: [producerId], references: [id])
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  createdAt     DateTime    @default(now())
}

model Report {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  createdAt DateTime @default(now())
}

model MarketListing {
  id            String      @id @default(cuid())
  title         String
  crop          String
  quantity      Float
  unit          String      @default("kg")
  pricePerUnit  Float?
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  mobileMoneyCheckouts MobileMoneyCheckout[]
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@index([active, createdAt])
  @@index([cooperativeId, active])
}

model MobileMoneyCheckout {
  id                  String                    @id @default(cuid())
  transactionId       String                    @unique
  amount              Int
  currency            String
  paymentUrl          String?
  providerReference   String?
  status              MobileMoneyCheckoutStatus @default(CREATED)
  buyerId             String
  buyer               User                      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cooperativeId       String
  cooperative         Cooperative               @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  marketListingId     String
  marketListing       MarketListing             @relation(fields: [marketListingId], references: [id], onDelete: Cascade)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  completedAt         DateTime?
  @@index([buyerId, createdAt])
  @@index([cooperativeId, createdAt])
  @@index([marketListingId, status])
}

model PriceReport {
  id            String      @id @default(cuid())
  crop          String
  marketName    String
  price         Float
  unit          String      @default("kg")
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  observedAt    DateTime    @default(now())
  createdAt     DateTime    @default(now())
  @@index([crop, observedAt])
  @@index([cooperativeId, observedAt])
}

model TransportRequest {
  id            String      @id @default(cuid())
  cargo         String
  quantity      Float
  unit          String      @default("kg")
  origin        String
  destination   String
  pickupDate    DateTime
  status        String      @default("OPEN")
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@index([cooperativeId, status, pickupDate])
}